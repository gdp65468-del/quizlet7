# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# QUIZ_ADMIN_PASSWORD: Admin password for signing in to host quizzes (defaults to "admin" if unset).
QUIZ_ADMIN_PASSWORD="alanxd"

# QUIZ_PUBLIC_ORIGIN: Optional public origin override for player join links and QR codes.
QUIZ_PUBLIC_ORIGIN=""

# QUIZ_JOIN_HOST: Optional LAN hostname/IP override for local hosting.
QUIZ_JOIN_HOST=""

# Appwrite (Free Cloud or Self-Hosted) configuration for cloud quiz & history sync.
# Create a free project at https://cloud.appwrite.io and set these variables in Secrets / .env.local:
NEXT_PUBLIC_APPWRITE_ENDPOINT="https://nyc.cloud.appwrite.io/v1"
NEXT_PUBLIC_APPWRITE_PROJECT_ID=""
NEXT_PUBLIC_APPWRITE_DATABASE_ID="quizlet_db"
NEXT_PUBLIC_APPWRITE_QUIZZES_COLLECTION_ID="quizzes"
NEXT_PUBLIC_APPWRITE_SESSIONS_COLLECTION_ID="gameSessions"
NEXT_PUBLIC_APPWRITE_LIVE_COLLECTION_ID="liveRooms"

# Server-only Appwrite API Key (required for Vercel/Netlify Serverless persistence of live rooms, quizzes, settings, and reports).
# Create in Appwrite Console -> Overview -> API Keys (Scopes: databases.*, collections.*, attributes.*, indexes.*, documents.*).
APPWRITE_API_KEY=""
